# Supabase project URL and publishable key only. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix this secret with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional model override; must support Responses API structured outputs.
OPENAI_STRATEGY_MODEL=gpt-5-mini
